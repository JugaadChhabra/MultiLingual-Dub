# Keys marked [required] must be set for the app to report itself configured.
# That list is derived from the settings classes in services/ — see
# services/settings.py — so it cannot drift from what the code actually reads.
# Everything else is optional and has a documented default or is only needed by
# a particular kind of request.

# --- HeyGen ---
HEYGEN_ISHWARI=          # [required]
ISHWARI_VOICE_ID=        # voice id for the Indian character
US_VOICE_ID=             # voice id for the US character
HEYGEN_BATCH_CONCURRENCY=4   # renders in flight at once during a video batch

# --- ElevenLabs ---
ELEVEN_LABS=             # [required]
DESI_VOCAL_VOICE=        # optional; falls back to a built-in voice id
ENGLISH_VOICE=           # only needed when a batch targets an English language

# --- Sarvam (translation + STT) ---
SARVAM_API=              # [required]

# --- Google Cloud Translation (v2) ---
# Handles fr/de/es/ru/pt (the languages Sarvam doesn't cover). Get a key from a
# GCP project with the Cloud Translation API enabled; quota is visible in the
# Cloud Console. Optional — only needed when a batch targets those languages.
GOOGLE_TRANSLATE_API_KEY= # optional

# --- OpenRouter (script writer, translation QC, story mode) ---
OPENROUTER_API_KEY=          # [required] https://openrouter.ai/settings/keys

# --- AWS S3 ---
AWS_ACCESS_KEY=          # [required]
AWS_SECRET_KEY=          # [required]
AWS_BUCKET=              # [required]
AWS_REGION=              # [required]
AWS_ENDPOINT_URL=        # optional; for S3-compatible storage
BATCH_ENABLE_S3_UPLOAD=false     # false = audio zips are written to disk instead
BATCH_ENABLE_QC=false            # [required] must be true — audio is only generated after QC
BATCH_MAX_LANGUAGE_PARALLELISM=  # optional; defaults to one task per target language

# --- Email notifications (Resend) ---
# All three, or notifications are silently skipped. Never fatal.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
NOTIFY_EMAILS=editor1@example.com,editor2@example.com

# --- NAS ---
# With none of these set, uploads go to ./nas_data locally, with a warning.
NAS_MODE=smb
NAS_ROOT_PATH=
NAS_SERVER=NAS._smb._tcp.local
NAS_SHARE=DATA
NAS_USERNAME=
NAS_PASSWORD=
NAS_DOMAIN=              # leave blank if no domain
NAS_PORT=445
US_CHARACTER_NAS_ROOT_PATH=      # optional; 'us' character videos land here instead

# --- Process tuning ---
# Deliberately NOT part of session config: these describe the machine, not the
# account, so they are read from the environment only and cannot be set by
# pasting a .env into the config panel.
API_RETRY_MAX_ATTEMPTS=
API_RETRY_BASE_DELAY=
# Max ElevenLabs TTS calls in flight across all audio jobs (Pro plan = 10).
ELEVENLABS_MAX_CONCURRENCY=10
# Worker threads shared by TTS, translation, compression and S3 calls.
APP_THREAD_POOL_SIZE=32
# Audio jobs (Excel sheets and stories) running at once; the rest wait in line.
AUDIO_MAX_CONCURRENT_JOBS=3
# Requests turned away before a job is made: Excel uploads over this size (413),
# sheets with more rows than this (400), and new jobs once this many already
# wait in line (503, try again later).
MAX_UPLOAD_MB=10
MAX_SHEET_ROWS=2000
MAX_QUEUED_JOBS=20
# New audio jobs get 507 while the output volume has less than this free.
MIN_FREE_DISK_GB=5
# Finished audio jobs (their local fallback zips and job record) are deleted
# this many days after they end. Video/HeyGen output is not touched by this.
OUTPUT_RETENTION_DAYS=14
# Video job folders (output/heygen/<job_id>/: TTS audio and renders) of jobs that
# ended are deleted this many hours later (fractions allowed). Job records, and
# queued/running/recovering jobs, are never deleted.
VIDEO_OUTPUT_RETENTION_HOURS=48
# Cached TTS audio (output/heygen/_audio_cache/*.mp3) not reused for this many
# days is deleted (fractions allowed). A cache hit counts as a use.
TTS_CACHE_RETENTION_DAYS=7
AUDIO_COMPRESS_FFMPEG_PATH=
AUDIO_COMPRESS_BITRATE=48k
AUDIO_COMPRESS_SAMPLE_RATE=24000
AUDIO_COMPRESS_CHANNELS=1
