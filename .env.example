# Keys marked [required] must be set for the app to report itself configured.
# That list is derived from the settings classes in services/ — see
# services/settings.py — so it cannot drift from what the code actually reads.
# Everything else is optional and has a documented default or is only needed by
# a particular kind of request.

# --- HeyGen ---
HEYGEN_ISHWARI=          # [required]
ISHWARI_VOICE_ID=        # voice id for the Indian character
US_VOICE_ID=             # voice id for the US character
HEYGEN_BATCH_CONCURRENCY=4   # renders in flight at once during a video batch

# --- ElevenLabs ---
ELEVEN_LABS=             # [required]
DESI_VOCAL_VOICE=        # optional; falls back to a built-in voice id
ENGLISH_VOICE=           # only needed when a batch targets an English language

# --- Sarvam (translation + STT) ---
SARVAM_API=              # [required]

# --- Gemini (translation QC) ---
GEMINI_API_KEY=          # [required]
GEMINI_QC_MODELS=        # optional CSV; defaults to gemini-2.5-flash,2.5-pro,2.0-flash
GEMINI_SCRIPT_MODELS=    # optional CSV for the script writer; defaults to gemini-2.5-pro,2.5-flash

# --- AWS S3 ---
AWS_ACCESS_KEY=          # [required]
AWS_SECRET_KEY=          # [required]
AWS_BUCKET=              # [required]
AWS_REGION=              # [required]
AWS_ENDPOINT_URL=        # optional; for S3-compatible storage
BATCH_ENABLE_S3_UPLOAD=false     # false = audio zips are written to disk instead
BATCH_ENABLE_QC=false            # [required] must be true — audio is only generated after QC
BATCH_MAX_LANGUAGE_PARALLELISM=  # optional; defaults to one task per target language

# --- Email notifications (Resend) ---
# All three, or notifications are silently skipped. Never fatal.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
NOTIFY_EMAILS=editor1@example.com,editor2@example.com

# --- NAS ---
# With none of these set, uploads go to ./nas_data locally, with a warning.
NAS_MODE=smb
NAS_ROOT_PATH=
NAS_SERVER=NAS._smb._tcp.local
NAS_SHARE=DATA
NAS_USERNAME=
NAS_PASSWORD=
NAS_DOMAIN=              # leave blank if no domain
NAS_PORT=445
US_CHARACTER_NAS_ROOT_PATH=      # optional; 'us' character videos land here instead

# --- Process tuning ---
# Deliberately NOT part of session config: these describe the machine, not the
# account, so they are read from the environment only and cannot be set by
# pasting a .env into the config panel.
API_RETRY_MAX_ATTEMPTS=
API_RETRY_BASE_DELAY=
AUDIO_COMPRESS_FFMPEG_PATH=
AUDIO_COMPRESS_BITRATE=48k
AUDIO_COMPRESS_SAMPLE_RATE=24000
AUDIO_COMPRESS_CHANNELS=1
